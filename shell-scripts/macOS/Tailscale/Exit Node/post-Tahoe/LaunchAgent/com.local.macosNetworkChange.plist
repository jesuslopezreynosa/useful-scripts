<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.local.macosNetworkChange</string>
        <key>ProgramArguments</key>
        <array>
            <string>/bin/zsh</string>
            <string>-c</string>
            <string>$HOME/.local/bin/triggerTailscaleShortcut.sh</string>
        </array>
        <key>WatchPaths</key>
        <array>
            <string>/Library/Preferences/SystemConfiguration</string>
            <string>/var/run/resolv.conf</string>
        </array>
        <key>ThrottleInterval</key>
        <integer>10</integer>
        <key>RunAtLoad</key>
        <true />
        <key>StandardOutPath</key>
        <string>/tmp/com.local.macosNetworkChange.out</string>
        <key>StandardErrorPath</key>
        <string>/tmp/com.local.macosNetworkChange.err</string>
    </dict>
</plist>